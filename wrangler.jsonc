{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dirtyfingaz-zp",
  "main": "./radio-worker.mjs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADIO_ROOMS",
        "class_name": "RadioRoom"
      }
    ]
  },
  "exports": {
    "RadioRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "AI_AGENT_ENABLED": "false"
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "AI_AGENT_ENABLED": "true"
    },
    "ai": {
      "binding": "AI"
    }
  },
  "ai": {
    "binding": "AI"
  }
}
